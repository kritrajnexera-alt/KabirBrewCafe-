---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteamDivider from '../components/SteamDivider.astro';
---

<BaseLayout
  title="Contact &amp; Reservations — Jin Bazar, Netrang"
  description="Find KabirBrewCafe in Jin Bazar, Netrang. Call +91 99090 40194 for reservations, delivery, or takeaway. Open 11 AM - 10 PM daily."
  currentPath={Astro.url.pathname}
>
  <section class="section contact-hero" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-hero-inner">
        <h1 id="contact-title">Find us, call us,<br>come by</h1>
        <div class="brass-divider"></div>
        <p class="body-large contact-lede">
          No online booking system, no chatbot. Just a phone number and a door that&rsquo;s
          open eleven hours a day.
        </p>
      </div>
    </div>
  </section>

  <SteamDivider />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-details">
          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <h3>Call us</h3>
            <a href="tel:+919909040194" class="contact-link">+91 99090 40194</a>
            <p class="body-small">For reservations, delivery, takeaway &mdash; just call.</p>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <h3>WhatsApp</h3>
            <a href="https://wa.me/919909040194" target="_blank" rel="noopener" class="contact-link">Message on WhatsApp</a>
            <p class="body-small">Same number. We reply fast during working hours.</p>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </div>
            <h3>Instagram</h3>
            <a href="https://www.instagram.com" target="_blank" rel="noopener" class="contact-link">@kabirbrewcafe</a>
            <p class="body-small">Follow for specials, events, and daily pizza shots.</p>
          </div>
        </div>

        <div class="contact-reserve">
          <h2 style="margin-bottom:16px;">Reserve a table</h2>
          <p class="body-small" style="margin-bottom:24px;">
            Planning to come with a group? Let us know and we&rsquo;ll save the back section.
            Same-day reservations welcome.
          </p>
          <form class="reserve-form" action="https://formspree.io/f/xdkrwkla" method="POST">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" required placeholder="+91 XXXXX XXXXX" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required />
              </div>
              <div class="form-group">
                <label for="time">Time</label>
                <input type="time" id="time" name="time" required />
              </div>
              <div class="form-group">
                <label for="guests">Guests</label>
                <input type="number" id="guests" name="guests" min="1" max="20" required placeholder="2" />
              </div>
            </div>
            <div class="form-group">
              <label for="message">Anything else?</label>
              <textarea id="message" name="message" rows="3" placeholder="Allergies, preferences, celebrations..."></textarea>
            </div>
            <button type="submit" class="btn-primary reserve-submit">
              Send Reservation Request
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h10.5M7.5 2.5L12 7l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <p class="body-small reserve-note">
              We&rsquo;ll confirm within 30 minutes during working hours.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <SteamDivider />

  <section class="section" aria-labelledby="location-title">
    <div class="container">
      <div class="location-grid">
        <div>
          <h2 id="location-title">Where to find us</h2>
          <div class="brass-divider"></div>
          <p class="body-large" style="margin-bottom:24px;">
            Jin Bazar, Netrang, Gujarat 393150
          </p>
          <div class="find-info-item">
            <div class="find-info-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <h4>Hours</h4>
              <p>Monday &ndash; Sunday &middot; 11 AM &ndash; 10 PM</p>
            </div>
          </div>
          <div class="find-info-item">
            <div class="find-info-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <h4>Landmark</h4>
              <p>Jin Bazar main market road, near the bus stand. Look for the warm-lit door.</p>
            </div>
          </div>
        </div>
        <div class="find-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3721.5!2d73.3!3d21.6!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjHCsDM2JzAwLjAiTiA3M8KwMTgnMDAuMCJF!5e0!3m2!1sen!2sin!4v1"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="KabirBrewCafe location on Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-top: 140px;
    padding-bottom: 48px;
  }
  .contact-hero-inner {
    max-width: 640px;
  }
  .contact-lede {
    max-width: 520px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .contact-card {
    background: var(--surface);
    border: 1px solid oklch(from var(--primary) l c h / 0.1);
    padding: 28px;
  }
  .contact-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(from var(--primary) l c h / 0.08);
    border: 1px solid oklch(from var(--primary) l c h / 0.15);
    color: var(--primary);
    border-radius: 50%;
    margin-bottom: 16px;
  }
  .contact-card h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .contact-link {
    display: block;
    font-size: 0.9375rem;
    color: var(--primary);
    font-weight: 500;
    margin-bottom: 8px;
    text-decoration: none;
  }
  .contact-link:hover {
    text-decoration: underline;
  }

  /* ─── RESERVATION FORM ─── */
  .contact-reserve {
    background: var(--surface);
    border: 1px solid oklch(from var(--primary) l c h / 0.1);
    padding: 36px 32px;
  }
  .reserve-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink);
  }
  .form-group input,
  .form-group textarea {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    padding: 12px 14px;
    background: oklch(0.10 0.005 60);
    border: 1px solid oklch(from var(--primary) l c h / 0.15);
    color: var(--ink);
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--muted);
  }
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--primary);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
  }
  .reserve-submit {
    width: 100%;
    justify-content: center;
  }
  .reserve-note {
    text-align: center;
    margin-top: 12px;
    color: var(--muted);
  }

  /* ─── LOCATION ─── */
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
    align-items: start;
  }
  .find-info-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .find-info-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(from var(--primary) l c h / 0.08);
    border: 1px solid oklch(from var(--primary) l c h / 0.15);
    color: var(--primary);
    border-radius: 50%;
  }
  .find-info-item h4 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .find-info-item p {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .find-map {
    width: 100%;
    height: 340px;
    background: var(--surface);
    border: 1px solid oklch(from var(--primary) l c h / 0.15);
    overflow: hidden;
  }
  .find-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr; }
    .location-grid { grid-template-columns: 1fr; gap: 32px; }
    .find-map { height: 280px; }
  }

  @media (max-width: 768px) {
    .contact-hero { padding-top: 100px; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
