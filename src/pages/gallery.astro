---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteamDivider from '../components/SteamDivider.astro';

const images = [
  { src: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=800&q=80", alt: "Wood-fired pizza with melted cheese and basil", span: "tall" },
  { src: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=800&q=80", alt: "Steaming cup of coffee on a wooden table", span: "wide" },
  { src: "https://images.unsplash.com/photo-1561758033-d89a9ad46330?w=800&q=80", alt: "Burger and fries on a cafe table", span: "" },
  { src: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefda?w=800&q=80", alt: "Coffee brewing setup with espresso machine", span: "" },
  { src: "https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=800&q=80", alt: "Margarita cocktail with lime and salt rim", span: "tall" },
  { src: "https://images.unsplash.com/photo-1540914124281-342587941389?w=800&q=80", alt: "Outdoor cafe seating area at golden hour", span: "wide" },
  { src: "https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=800&q=80", alt: "Fresh garlic bread with herbs", span: "" },
  { src: "https://images.unsplash.com/photo-1558642452-9d2a7deb7f62?w=800&q=80", alt: "Four cheese pizza slice close-up", span: "wide" },
  { src: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&q=80", alt: "Latte art on a wooden counter", span: "" },
  { src: "https://images.unsplash.com/photo-1555126634-323283e090fa?w=800&q=80", alt: "Pizza being taken out of wood-fired oven", span: "tall" },
  { src: "https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=800&q=80", alt: "Evening cafe atmosphere with warm lighting", span: "" },
  { src: "https://images.unsplash.com/photo-1453614512568-c4024d13c247?w=800&q=80", alt: "Coffee and notebook on a quiet cafe table", span: "wide" },
];
---

<BaseLayout
  title="Gallery — Cafe Atmosphere &amp; Food"
  description="Browse photos of KabirBrewCafe in Jin Bazar, Netrang. Wood-fired pizzas, coffee, margaritas, and our outdoor courtyard."
>
  <section class="section gallery-hero" aria-labelledby="gallery-title">
    <div class="container">
      <p class="caption">The atmosphere</p>
      <h1 id="gallery-title">Inside KabirBrewCafe</h1>
      <div class="brass-divider"></div>
      <p class="body-large gallery-lede">
        The wood-fired oven, the quiet courtyard, the evening light &mdash; 
        this is what it looks like when you're here.
      </p>
    </div>
  </section>

  <SteamDivider />

  <section class="section" aria-label="Photo gallery">
    <div class="container">
      <div class="gallery-grid">
        {images.map((img) => (
          <figure class={`gallery-item ${img.span}`}>
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section gallery-cta-section" aria-labelledby="visit-title">
    <div class="container" style="text-align:center;">
      <h2 id="visit-title" style="margin-bottom:16px;">Come see it yourself</h2>
      <p class="body-large" style="max-width:480px; margin:0 auto 28px;">
        Jin Bazar, Netrang. 11 AM to 10 PM. Walk in anytime.
      </p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="btn-primary">Find Us</a>
        <a href="tel:+919909040194" class="btn-secondary">Call +91 99090 40194</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-hero {
    padding-top: 140px;
    padding-bottom: 24px;
  }
  .gallery-lede {
    max-width: 520px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    grid-auto-flow: dense;
  }
  .gallery-item {
    margin: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid oklch(from var(--primary) l c h / 0.1);
    line-height: 0;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery-item:hover img {
    transform: scale(1.05);
  }
  .gallery-item.wide {
    grid-column: span 2;
  }
  .gallery-item.tall {
    grid-row: span 2;
  }
  .gallery-item.wide.tall {
    grid-column: span 2;
    grid-row: span 2;
  }
  .gallery-cta-section {
    background: oklch(0.07 0.005 60);
  }

  @media (max-width: 768px) {
    .gallery-hero { padding-top: 100px; }
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .gallery-item.wide { grid-column: span 1; }
    .gallery-item.tall { grid-row: span 1; }
  }

  @media (max-width: 375px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
